[settings]
idiomatic_version_file_enable_tools = ["ruby"]

[settings.ruby]
compile = false

[tools]
{{ if .cru }}
"asdf:CruGlobal/asdf-cru-cli" = "latest"
dotenvx = "latest"
{{ end }}
ruby = "latest"
yarn = "latest"

{{ if .cru }}
[shell_alias]
local-stage = "local-env staging"
local-uat = "local-env uat"

[tasks.deploy-status]
dir = {{ `"{{cwd}}"` }}
run = "gh workflow view build-deploy-ecs.yml"
{{ end }}
